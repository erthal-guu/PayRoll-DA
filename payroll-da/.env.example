# Copie para ".env" (que NÃO vai para o git) e preencha. Nunca coloque segredos neste arquivo de exemplo.

# Domínio apontando para o IP do servidor (ex.: payroll.meusite.com.br). Gera o HTTPS sozinho.
DOMINIO=payroll.exemplo.com.br

# Senha do Postgres (use uma forte).
DB_PASSWORD=troque-esta-senha

# Administrador criado na primeira subida (troque a senha depois, em Usuários).
ADMIN_EMAIL=voce@exemplo.com.br
ADMIN_SENHA=troque-esta-senha

# Chave do Groq (assistente de IA). Opcional: sem ela o assistente fica desligado.
GROQ_API_KEY=
